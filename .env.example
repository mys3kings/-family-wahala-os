# Create a Redis database in the Upstash Marketplace integration and copy its REST credentials.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Set a long, random secret. Use this exact value after ?key= in the private admin URL.
ADMIN_KEY=

# Required for secure username/password accounts and cross-device cloud sync.
# Get the service_role secret from Supabase Project Settings > API Keys.
# SERVER ONLY: never prefix this value with NEXT_PUBLIC_ or expose it in client code.
SUPABASE_URL=https://buizhlesqyzdobydlzoz.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Generate a long random secret (at least 32 characters).
AUTH_SESSION_SECRET=
